import os
import sys
import json
import re
import urllib.request
import urllib.parse

def load_env_file(filepath=".env"):
    if os.path.exists(filepath):
        with open(filepath, "r") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, val = line.split("=", 1)
                    os.environ[key.strip()] = val.strip()

load_env_file()

try:
    import google.generativeai as genai
    GEMINI_AVAILABLE = True
except ImportError:
    GEMINI_AVAILABLE = False


class AiAgent17AutonomousSfxAlchemistSynthesizer:
    def __init__(self, workspace_dir="znet_workspace", sfx_export_dir="znet_exports/audio_sfx"):
        self.agent_name = "Ai Agent 17: autonomous_sfx_alchemist_synthesizer"
        self.workspace_dir = workspace_dir
        self.sfx_export_dir = sfx_export_dir
        self.state_file = os.path.join(self.workspace_dir, "matrix_state.json")

        if not os.path.exists(self.sfx_export_dir):
            os.makedirs(self.sfx_export_dir)

        self.ollama_url = "http://localhost:11434/api/chat"
        self.openai_url = "https://api.openai.com/v1/chat/completions"
        self.model_local = "llama3"
        self.model_cloud = "gpt-4o-mini"
        
        self.gemini_api_key = os.environ.get("GEMINI_API_KEY", None)
        self.openai_api_key = os.environ.get("OPENAI_API_KEY", None)
        self.freesound_api_key = os.environ.get("FREESOUND_API_KEY", None)

        if GEMINI_AVAILABLE and self.gemini_api_key:
            genai.configure(api_key=self.gemini_api_key)

    def log(self, message, level="INFO"):
        print(f"[{level}] [{self.agent_name}] {message}")

    def _load_matrix_state(self):
        if not os.path.exists(self.state_file):
            self.log("matrix_state.json not found. Upstream modules must run first.", "ERROR")
            sys.exit(1)
        with open(self.state_file, "r", encoding="utf-8") as f:
            return json.load(f)

    def _save_matrix_state(self, state_data):
        with open(self.state_file, "w", encoding="utf-8") as f:
            json.dump(state_data, f, indent=4)
        self.log("OmniMatrix state successfully updated with SFX Alchemist Blueprints.")

    def _clean_json_response(self, raw_text):
        cleaned = raw_text.strip()
        cleaned = re.sub(r"^```json\s*", "", cleaned, flags=re.IGNORECASE)
        cleaned = re.sub(r"^```\s*", "", cleaned, flags=re.IGNORECASE)
        cleaned = re.sub(r"\s*```$", "", cleaned)
        
        start_idx = cleaned.find('{')
        end_idx = cleaned.rfind('}')
        if start_idx != -1 and end_idx != -1:
            cleaned = cleaned[start_idx:end_idx + 1]
        return cleaned

    def _download_file(self, url, filename):
        file_path = os.path.join(self.sfx_export_dir, filename)
        try:
            req = urllib.request.Request(url, headers={'User-Agent': 'OmniMatrix-Engine/1.0'})
            with urllib.request.urlopen(req, timeout=30) as response, open(file_path, 'wb') as out_file:
                out_file.write(response.read())
            self.log(f"Freesound SFX Downloaded: {filename}")
            return file_path
        except Exception as e:
            self.log(f"Failed to download audio file: {str(e)}", "ERROR")
            return None

    def fetch_real_sfx(self, query):
        """Attempts to find a real audio file via Freesound API to compliment the synth."""
        if not self.freesound_api_key:
            return None

        clean_query = re.sub(r'[^a-zA-Z0-9\s]', '', query).strip()
        safe_query = urllib.parse.quote(clean_query)
        
        url = f"[https://freesound.org/apiv2/search/text/?query=](https://freesound.org/apiv2/search/text/?query=){safe_query}&token={self.freesound_api_key}&fields=id,name,previews&page_size=1"
        
        try:
            req = urllib.request.Request(url, headers={'User-Agent': 'OmniMatrix-Engine/1.0'})
            with urllib.request.urlopen(req, timeout=15) as response:
                res_data = json.loads(response.read().decode("utf-8"))
                results = res_data.get("results", [])
                if results:
                    previews = results[0].get("previews", {})
                    preview_url = previews.get("preview-hq-mp3") or previews.get("preview-lq-mp3")
                    if preview_url:
                        clean_filename_q = re.sub(r'\s+', '_', clean_query).lower()[:20]
                        filename = f"sfx_asset_{clean_filename_q}.mp3"
                        return self._download_file(preview_url, filename)
        except Exception as e:
            self.log(f"Freesound search failed for '{query}': {str(e)}", "WARNING")
        return None

    def design_sfx_blueprints_ai(self, bpm, action_cues):
        """Queries AI logic cores to construct precise DSP synthesizer parameters."""
        system_prompt = (
            "You are an elite Hollywood sound designer and DSP synthesizer programmer. "
            "Analyze the given video action cues and output precise synthesizer instructions to generate cinematic sounds from scratch.\n"
            "Return STRICTLY a JSON object containing a list named 'synthesized_sfx_parameters'.\n"
            "Each parameter block must contain:\n"
            "- 'timestamp_sec': float matching the action cue timestamp.\n"
            "- 'sfx_class': string (choose from: 'riser-whoosh', 'impact-blast', 'glitch-static', 'metallic-laser').\n"
            "- 'oscillator_wave': string (choose from: 'noise-pink', 'sine-mod', 'sawtooth-aggressive', 'square-pulse').\n"
            "- 'filter_envelope': object with 'cutoff_start_hz' (200-12000), 'cutoff_end_hz' (20-8000), and 'resonance' (0.1-0.9).\n"
            "- 'duration_seconds': float (0.3 to 3.0).\n"
            "- 'panning_trajectory': string ('left-to-right', 'right-to-left', 'center-wide', 'ping-pong').\n"
            "- 'reverb_room_size': float (0.0 to 1.0).\n"
            "- 'vibe_narrative_note': string (e.g., 'Saber slash slicing air').\n"
        )
        
        user_prompt = f"Video BPM: {bpm}\nAction Cues:\n{json.dumps(action_cues, indent=2)}"

        if GEMINI_AVAILABLE and self.gemini_api_key:
            self.log("Routing to Core 1: Gemini AI for DSP sound architecture...")
            try:
                model = genai.GenerativeModel("gemini-1.5-flash")
                response = model.generate_content(
                    system_prompt + "\n\n" + user_prompt,
                    generation_config={"response_mime_type": "application/json"}
                )
                return json.loads(response.text.strip()).get("synthesized_sfx_parameters", [])
            except Exception as e:
                self.log(f"Gemini Engine failed: {e}. Switching to OpenAI fallback.", "WARNING")

        if self.openai_api_key:
            self.log(f"Routing to Core 2: OpenAI API [{self.model_cloud}]...")
            url = self.openai_url
            headers = {"Content-Type": "application/json", "Authorization": f"Bearer {self.openai_api_key}"}
            payload = {
                "model": self.model_cloud,
                "messages": [
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": user_prompt}
                ],
                "response_format": {"type": "json_object"}
            }
            try:
                req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"), headers=headers)
                with urllib.request.urlopen(req, timeout=30) as response:
                    res_data = json.loads(response.read().decode("utf-8"))
                    raw_text = res_data["choices"][0]["message"]["content"]
                    return json.loads(self._clean_json_response(raw_text)).get("synthesized_sfx_parameters", [])
            except Exception as e:
                self.log(f"OpenAI Engine failed: {e}. Engaging Math Fallback.", "WARNING")

        self.log("All AI Cores failed. Engaging Offline Procedural Synthesis Logic.", "STATUS")
        return self._execute_procedural_fallback(action_cues)

    def _execute_procedural_fallback(self, cues):
        """Mathematical fallback for sound design generation."""
        sfx_list = []
        for cue in cues:
            ts = float(cue.get("timestamp_sec", 1.0))
            intensity = float(cue.get("intensity", 0.7))
            
            if intensity >= 0.9:
                sfx_class, osc, note = "impact-blast", "sawtooth-aggressive", "Heavy cinematic impact"
            elif intensity >= 0.7:
                sfx_class, osc, note = "riser-whoosh", "noise-pink", "Fast air swoosh"
            else:
                sfx_class, osc, note = "glitch-static", "square-pulse", "UI glitch transition"

            sfx_list.append({
                "timestamp_sec": ts,
                "sfx_class": sfx_class,
                "oscillator_wave": osc,
                "filter_envelope": {"cutoff_start_hz": 8000, "cutoff_end_hz": 100, "resonance": 0.5},
                "duration_seconds": 1.5,
                "panning_trajectory": "center-wide",
                "reverb_room_size": 0.6,
                "vibe_narrative_note": note
            })
        return sfx_list

    def process_sfx_generation(self):
        state = self._load_matrix_state()
        
        target_agent = state.get("pipeline_status", {}).get("next_agent", "")
        if target_agent and target_agent != "Ai_Agent_17":
            self.log(f"Pipeline sequence mismatch. Expected {target_agent}, but executing {self.agent_name}.", "WARNING")

        # Fetch action cues from Module A (Visual Storyboard) if available
        # Fallback to generating cues based on Beat Map
        storyboard = state.get("module_a_scripting", {}).get("storyboard_mapping", {})
        beat_map_data = state.get("module_b_audio", {}).get("phonk_beat_map", {})
        
        bpm = beat_map_data.get("target_bpm", 130)
        action_cues = []

        if storyboard:
            panels = storyboard.get("panels", [])
            for panel in panels:
                ts = panel.get("timestamp_sec", 0.0)
                desc = panel.get("prompt", "").lower()
                intensity = 0.9 if any(x in desc for x in ["fight", "punch", "explode"]) else 0.5
                action_cues.append({"timestamp_sec": ts, "intensity": intensity, "desc": desc})
        
        if not action_cues:
            self.log("No Visual Storyboard found. Extrapolating Action Cues from Audio Beat Map.", "WARNING")
            events = beat_map_data.get("beat_sync_events", [])
            for ev in events:
                if ev.get("impact_intensity", 0.0) > 0.6:
                    action_cues.append({"timestamp_sec": ev.get("timestamp_sec"), "intensity": ev.get("impact_intensity"), "desc": "Heavy music beat impact transition"})

        if not action_cues:
            self.log("No data available to generate SFX. Exiting.", "ERROR")
            return

        self.log(f"Alchemist Engine active. Synthesizing blueprints for {len(action_cues)} visual cues...")
        sfx_blueprints = self.design_sfx_blueprints_ai(bpm, action_cues)

        # Enhance blueprints by attempting to download complimentary real audio
        for sfx in sfx_blueprints:
            query = " ".join(sfx.get("vibe_narrative_note", "").split()[:3])
            real_audio_path = self.fetch_real_sfx(query)
            if real_audio_path:
                sfx["downloaded_real_sfx_path"] = real_audio_path

        state["module_b_audio"]["sfx_synthesizer_blueprints"] = sfx_blueprints
        
        # Pipeline Handshake
        state["pipeline_status"]["last_active_agent"] = "Ai_Agent_17"
        state["pipeline_status"]["next_agent"] = "Agent_18"
        
        self._save_matrix_state(state)
        self.log("Success! SFX architecture integrated into OmniMatrix. Handoff to Agent 18.")

if __name__ == "__main__":
    synthesizer = AiAgent17AutonomousSfxAlchemistSynthesizer()
    synthesizer.process_sfx_generation()
    print("\n--- OMNIMATRIX MODULE B: AGENT 17 COMPLETE ---")
