import os
import sys
import json
import re
import urllib.request
import urllib.parse
import wave
import math
import struct
import random

def load_env_file(filepath=".env"):
    if os.path.exists(filepath):
        with open(filepath, "r") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, val = line.split("=", 1)
                    os.environ[key.strip()] = val.strip()

load_env_file()

try:
    import google.generativeai as genai
    GEMINI_AVAILABLE = True
except ImportError:
    GEMINI_AVAILABLE = False


class AiAgent17AutonomousSfxAlchemistSynthesizer:
    def __init__(self):
        self.agent_name = "Ai_Agent_17"
        self.workspace_dir = os.path.join(os.getcwd(), "OmniMatrix_Workspace")
        self.sfx_export_dir = os.path.join(self.workspace_dir, "Exports", "SFX_Assets")
        self.state_file = os.path.join(self.workspace_dir, "matrix_state.json")

        # Idempotent Workspace Creation
        if not os.path.exists(self.sfx_export_dir):
            os.makedirs(self.sfx_export_dir)

        self.ollama_url = "http://localhost:11434/api/generate"
        self.openai_url = "https://api.openai.com/v1/chat/completions"
        self.model_local = "llama3"
        self.model_cloud = "gpt-4o-mini"
        
        self.gemini_api_key = os.environ.get("GEMINI_API_KEY", None)
        self.openai_api_key = os.environ.get("OPENAI_API_KEY", None)

        if GEMINI_AVAILABLE and self.gemini_api_key:
            genai.configure(api_key=self.gemini_api_key)

    def log(self, message, level="INFO"):
        print(f"[{level}] [{self.agent_name}] {message}")

    def _load_matrix_state(self):
        if not os.path.exists(self.state_file):
            self.log("matrix_state.json not found. Run upstream modules first.", "FATAL")
            sys.exit(1)
        try:
            with open(self.state_file, "r", encoding="utf-8") as f:
                return json.load(f)
        except json.JSONDecodeError as e:
            self.log(f"JSON Corruption detected: {e}", "FATAL")
            sys.exit(1)

    def _save_matrix_state(self, state_data):
        with open(self.state_file, "w", encoding="utf-8") as f:
            json.dump(state_data, f, indent=4, ensure_ascii=False)
        self.log("OmniMatrix state successfully updated with Synthesized SFX Audio.", "SUCCESS")

    def _clean_json_response(self, raw_text):
        cleaned = raw_text.strip()
        cleaned = re.sub(r"^```json\s*", "", cleaned, flags=re.IGNORECASE)
        cleaned = re.sub(r"^```\s*", "", cleaned, flags=re.IGNORECASE)
        cleaned = re.sub(r"\s*```$", "", cleaned)
        
        start_idx = cleaned.find('{')
        end_idx = cleaned.rfind('}')
        if start_idx != -1 and end_idx != -1:
            cleaned = cleaned[start_idx:end_idx + 1]
        return cleaned

    def _scrub_old_sfx(self):
        """Idempotency Rule: Cleans previous SFX generations to prevent bloat."""
        for filename in os.listdir(self.sfx_export_dir):
            file_path = os.path.join(self.sfx_export_dir, filename)
            try:
                if os.path.isfile(file_path):
                    os.unlink(file_path)
            except Exception as e:
                self.log(f"Failed to delete {file_path}. Reason: {e}", "WARNING")

    def synthesize_actual_wav(self, profile, filename):
        """
        THE ALCHEMIST ENGINE:
        Actually generates a .wav file purely mathematically using Python.
        No external dependencies. KHOD SFX BNA RAHA HAI.
        """
        file_path = os.path.join(self.sfx_export_dir, filename)
        sfx_class = profile.get("sfx_class", "impact-blast")
        duration = profile.get("duration_seconds", 1.0)
        
        sample_rate = 44100
        num_samples = int(duration * sample_rate)
        
        try:
            with wave.open(file_path, 'w') as wav_file:
                wav_file.setnchannels(1) # Mono
                wav_file.setsampwidth(2) # 16-bit
                wav_file.setframerate(sample_rate)
                
                for i in range(num_samples):
                    t = float(i) / sample_rate
                    val = 0.0
                    
                    if sfx_class == "impact-blast":
                        # Low frequency boom + white noise crunch (exponential decay)
                        envelope = math.exp(-t * 6)
                        sub_bass = math.sin(2 * math.pi * 40 * t)
                        noise = random.uniform(-1.0, 1.0) * 0.4
                        val = (sub_bass + noise) * envelope
                        
                    elif sfx_class == "riser-whoosh":
                        # Pitch shifting sine wave getting louder
                        freq = 50 + (t / duration) * 800  # Sweeps from 50Hz to 850Hz
                        envelope = (t / duration)  # Gets louder over time
                        val = math.sin(2 * math.pi * freq * t) * envelope
                        
                    elif sfx_class == "glitch-static":
                        # Square wave stutters
                        envelope = math.exp(-t * 2)
                        if (i % 2000) < 1000:  # Choppy binary effect
                            val = random.choice([-1.0, 1.0]) * envelope
                        else:
                            val = 0.0
                            
                    elif sfx_class == "metallic-laser":
                        # Fast high-pitch FM synthesis drop
                        freq = 2000 * math.exp(-t * 10)
                        envelope = math.exp(-t * 8)
                        val = math.sin(2 * math.pi * freq * t) * envelope
                    
                    else:
                        # Fallback basic beep with fade out
                        val = math.sin(2 * math.pi * 440 * t) * math.exp(-t * 3)

                    # Hard clipping protector and 16-bit conversion
                    val = max(-1.0, min(1.0, val))
                    packed_val = struct.pack('h', int(val * 32767.0))
                    wav_file.writeframes(packed_val)
                    
            self.log(f"Synthesized DSP Audio File Generated: {filename}")
            return file_path
        except Exception as e:
            self.log(f"Failed to synthesize wave file {filename}: {e}", "ERROR")
            return None

    def design_sfx_blueprints_ai(self, video_format, bpm, action_cues):
        """
        UNIVERSAL AI LOGIC CORE:
        Designs DSP parameters contextually based on Long-Form vs Short-Form.
        """
        
        if video_format == "long_form":
            style_guide = "Cinematic, slow-paced, atmospheric Hans Zimmer style documentaries."
            freq = "low frequency, soft attack, long decays"
            sfx_options = "'riser-whoosh', 'impact-blast'" # Keep it organic and cinematic
        else:
            style_guide = "Aggressive, fast-paced Anime/Phonk/TikTok edits."
            freq = "high frequency, hard attack, glitch stutters"
            sfx_options = "'riser-whoosh', 'impact-blast', 'glitch-static', 'metallic-laser'"

        system_prompt = (
            f"You are an elite Hollywood sound designer. Style: {style_guide}\n"
            f"Focus on {freq}.\n"
            "Analyze the given video action cues and output precise synthesizer instructions to generate sounds.\n"
            "Return STRICTLY a JSON object containing a list named 'synthesized_sfx_parameters'.\n"
            "Each parameter block must contain:\n"
            "- 'timestamp_sec': float matching the action cue timestamp.\n"
            f"- 'sfx_class': string (choose from: {sfx_options}).\n"
            "- 'duration_seconds': float (0.3 to 3.0).\n"
            "- 'vibe_narrative_note': string describing the visual action.\n"
        )
        
        user_prompt = f"Format: {video_format.upper()}\nBPM: {bpm}\nAction Cues:\n{json.dumps(action_cues, indent=2)}"

        # CORE 1: Gemini
        if GEMINI_AVAILABLE and self.gemini_api_key:
            self.log("Routing to Core 1: Gemini AI for DSP sound architecture...")
            try:
                model = genai.GenerativeModel("gemini-1.5-flash")
                response = model.generate_content(
                    system_prompt + "\n\n" + user_prompt,
                    generation_config={"response_mime_type": "application/json"}
                )
                return json.loads(response.text.strip()).get("synthesized_sfx_parameters", [])
            except Exception as e:
                self.log(f"Gemini Engine failed: {e}. Switching to OpenAI fallback.", "WARNING")

        # CORE 2: OpenAI
        if self.openai_api_key:
            self.log(f"Routing to Core 2: OpenAI API [{self.model_cloud}]...")
            url = self.openai_url
            headers = {"Content-Type": "application/json", "Authorization": f"Bearer {self.openai_api_key}"}
            payload = {
                "model": self.model_cloud,
                "messages": [
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": user_prompt}
                ],
                "response_format": {"type": "json_object"}
            }
            try:
                req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"), headers=headers)
                with urllib.request.urlopen(req, timeout=30) as response:
                    res_data = json.loads(response.read().decode("utf-8"))
                    raw_text = res_data["choices"][0]["message"]["content"]
                    return json.loads(self._clean_json_response(raw_text)).get("synthesized_sfx_parameters", [])
            except Exception as e:
                self.log(f"OpenAI Engine failed: {e}. Switching to Ollama Local Fallback.", "WARNING")

        # CORE 3: Ollama
        self.log(f"Routing to Core 3: Local Ollama [{self.model_local}]...", "STATUS")
        try:
            payload = {
                "model": self.model_local,
                "prompt": system_prompt + "\n\n" + user_prompt,
                "stream": False,
                "format": "json"
            }
            req = urllib.request.Request(self.ollama_url, data=json.dumps(payload).encode("utf-8"), headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=60) as response:
                res_data = json.loads(response.read().decode("utf-8"))
                raw_text = res_data.get("response", "")
                return json.loads(self._clean_json_response(raw_text)).get("synthesized_sfx_parameters", [])
        except Exception as e:
            self.log(f"Ollama Engine failed: {e}. Engaging Math Fallback.", "WARNING")

        # CORE 4: Procedural Synthesis Logic
        self.log("All AI Cores failed. Engaging Offline Procedural Synthesis Logic.", "STATUS")
        return self._execute_procedural_fallback(action_cues, video_format)

    def _execute_procedural_fallback(self, cues, video_format):
        sfx_list = []
        for cue in cues:
            ts = float(cue.get("timestamp_sec", 1.0))
            intensity = float(cue.get("intensity", 0.7))
            
            if video_format == "long_form":
                sfx_class = "impact-blast" if intensity > 0.8 else "riser-whoosh"
                duration = 2.0
            else:
                sfx_class = "metallic-laser" if intensity > 0.8 else "glitch-static"
                duration = 0.5

            sfx_list.append({
                "timestamp_sec": ts,
                "sfx_class": sfx_class,
                "duration_seconds": duration,
                "vibe_narrative_note": "Procedurally generated fallback SFX"
            })
        return sfx_list

    def process_sfx_generation(self):
        state = self._load_matrix_state()
        
        # 1. Atomic Handshake
        orchestrator = state.get("orchestrator_matrix", {})
        if orchestrator.get("next_agent") != self.agent_name:
            self.log(f"Execution suspended. Orchestrator expected '{orchestrator.get('next_agent')}'.", "WARNING")
            sys.exit(0)

        # 2. Universal Config
        global_config = state.get("global_config", {})
        video_format = global_config.get("video_format", "short_form").lower()

        # Idempotency Scrubbing
        self._scrub_old_sfx()
        
        beat_map_data = state.get("module_b_audio", {}).get("phonk_beat_map", {})
        bpm = beat_map_data.get("target_bpm", 130)
        
        action_cues = []
        # Attempt to grab high-intensity beat drops for SFX mapping
        events = beat_map_data.get("beat_sync_events", [])
        for ev in events:
            if ev.get("impact_intensity", 0.0) >= 0.6:  # Threshold for triggering SFX
                action_cues.append({
                    "timestamp_sec": ev.get("timestamp_sec"), 
                    "intensity": ev.get("impact_intensity"), 
                    "desc": ev.get("editor_action_note", "Beat drop impact")
                })

        if not action_cues:
            self.log("No dynamic points found to generate SFX. Exiting gracefully.", "WARNING")
            orchestrator["last_active_agent"] = self.agent_name
            orchestrator["next_agent"] = "Ai_Agent_18"
            self._save_matrix_state(state)
            return

        self.log(f"Alchemist Engine active. Generating blueprints for {len(action_cues)} visual cues...")
        sfx_blueprints = self.design_sfx_blueprints_ai(video_format, bpm, action_cues)

        # 3. ACTUAL WAVE FILE SYNTHESIS (God-Level Feature)
        self.log(f"Initializing DSP Core. Synthesizing {len(sfx_blueprints)} actual audio files...", "STATUS")
        for idx, sfx in enumerate(sfx_blueprints):
            filename = f"synth_{video_format}_{idx}_{sfx.get('sfx_class')}.wav"
            filepath = self.synthesize_actual_wav(sfx, filename)
            if filepath:
                sfx["synthesized_file_path"] = filepath

        state["module_b_audio"]["sfx_synthesizer_blueprints"] = sfx_blueprints
        
        # 4. Pipeline Handshake
        state["orchestrator_matrix"]["last_active_agent"] = self.agent_name
        # Handoff to Agent 18 (likely Master Audio Mixing)
        state["orchestrator_matrix"]["next_agent"] = "Ai_Agent_18"
        
        self._save_matrix_state(state)
        self.log("Success! Actual .WAV SFX files generated and integrated into OmniMatrix. Handoff to Agent 18.")

if __name__ == "__main__":
    synthesizer = AiAgent17AutonomousSfxAlchemistSynthesizer()
    synthesizer.process_sfx_generation()
