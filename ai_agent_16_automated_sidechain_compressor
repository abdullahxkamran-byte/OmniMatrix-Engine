import os
import sys
import json

class OmniMatrixAutomatedSidechainCompressor:
    def __init__(self, workspace_dir="znet_workspace"):
        self.agent_name = "Agent 16: automated_sidechain_compressor"
        self.workspace_dir = workspace_dir
        self.state_file = os.path.join(self.workspace_dir, "matrix_state.json")

    def log(self, message, level="INFO"):
        print(f"[{level}] [{self.agent_name}] {message}")

    def _load_matrix_state(self):
        """Loads the central OmniMatrix state file."""
        if not os.path.exists(self.state_file):
            self.log("matrix_state.json not found. Run upstream modules first.", "ERROR")
            sys.exit(1)
        with open(self.state_file, "r", encoding="utf-8") as f:
            return json.load(f)

    def _save_matrix_state(self, state_data):
        """Saves the sidechain blueprint back to the central state."""
        with open(self.state_file, "w", encoding="utf-8") as f:
            json.dump(state_data, f, indent=4)
        self.log("OmniMatrix state successfully updated with Sidechain Compression triggers.")

    def calculate_ducking_physics(self, sub_profile):
        """
        Pure mathematical utility to calculate audio compression parameters.
        No LLM needed. Deterministic and instantaneous.
        """
        gain = float(sub_profile.get("target_gain_db", -2.0))
        sweep_duration = float(sub_profile.get("sweep_duration_seconds", 1.2))

        # Hard ducking on heavy peaks, soft ducking on low rumbles
        if gain > -2.0:
            threshold = -40.0
            ratio = "12:1"
            attack = 1.5
            ducking = -12.0
        else:
            threshold = -30.0
            ratio = "6:1"
            attack = 4.0
            ducking = -6.0

        # Convert sweep duration to millisecond release with 75% offset
        release = round((sweep_duration * 1000.0) * 0.75, 1)
        # Safe boundary constraints for audio engine (FFmpeg/DAW)
        release = max(80.0, min(release, 350.0))

        return {
            "threshold_db": threshold,
            "ratio": ratio,
            "attack_time_ms": attack,
            "release_time_ms": release,
            "ducking_depth_db": ducking,
            "routing_target": "background_music_and_sfx"
        }

    def execute_compression_routing(self):
        state = self._load_matrix_state()
        
        # Pipeline Sequence Validation
        target_agent = state.get("pipeline_status", {}).get("next_agent", "")
        if target_agent and target_agent != "Agent_16":
            self.log(f"Pipeline sequence mismatch. Expected {target_agent}, but executing {self.agent_name}.", "WARNING")

        audio_module = state.get("module_b_audio", {})
        beat_map_data = audio_module.get("phonk_beat_map", {})
        events = beat_map_data.get("beat_sync_events", [])
        
        if not events:
            self.log("Beat events are missing. Ensure Agent 14 and 15 ran successfully.", "ERROR")
            return

        self.log("Calculating procedural sidechain physics for master audio mix...")
        
        processed_triggers = 0

        # Iterate through events and apply sidechain math to those with sub-bass blueprints
        for event in events:
            sub_profile = event.get("sub_bass_dsp_blueprint")
            if sub_profile:
                ducking_params = self.calculate_ducking_physics(sub_profile)
                event["sidechain_ducking_trigger"] = ducking_params
                processed_triggers += 1

        state["module_b_audio"]["phonk_beat_map"]["beat_sync_events"] = events
        state["module_b_audio"]["sidechain_compression_applied"] = True
        
        # OmniMatrix Pipeline Handshake
        state["pipeline_status"]["last_active_agent"] = "Agent_16"
        state["pipeline_status"]["next_agent"] = "Ai_Agent_17"
        
        self._save_matrix_state(state)
        self.log(f"Success! {processed_triggers} sidechain routing triggers mathematically generated. Handoff to Ai Agent 17.")

if __name__ == "__main__":
    compressor = OmniMatrixAutomatedSidechainCompressor()
    compressor.execute_compression_routing()
    print("\n--- OMNIMATRIX MODULE B: AGENT 16 UTILITY COMPLETE ---")
