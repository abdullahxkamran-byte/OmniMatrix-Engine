import os
import sys
import json

class Agent16AutomatedSidechainCompressor:
    def __init__(self):
        self.agent_name = "Agent_16"
        # Universal Workspace Isolation
        self.workspace_dir = os.path.join(os.getcwd(), "OmniMatrix_Workspace")
        self.state_file = os.path.join(self.workspace_dir, "matrix_state.json")

    def log(self, message, level="INFO"):
        print(f"[{level}] [{self.agent_name}] {message}")

    def _load_matrix_state(self):
        """Loads the central OmniMatrix state safely."""
        if not os.path.exists(self.state_file):
            self.log("matrix_state.json not found. Run upstream modules first.", "FATAL")
            sys.exit(1)
        try:
            with open(self.state_file, "r", encoding="utf-8") as f:
                return json.load(f)
        except json.JSONDecodeError as e:
            self.log(f"JSON Corruption detected: {e}", "FATAL")
            sys.exit(1)

    def _save_matrix_state(self, state_data):
        """Saves the sidechain blueprint back to the central state."""
        with open(self.state_file, "w", encoding="utf-8") as f:
            json.dump(state_data, f, indent=4, ensure_ascii=False)
        self.log("OmniMatrix state successfully updated with Sidechain Compression triggers.", "SUCCESS")

    def calculate_ducking_physics(self, sub_profile, video_format):
        """
        UNIVERSAL MATH ENGINE: Calculates audio compression parameters procedurally.
        Adapts parameters based on Long-Form Cinematic or Short-Form Aggressive edits.
        """
        gain = float(sub_profile.get("target_gain_db", -2.0))
        sweep_duration = float(sub_profile.get("sweep_duration_seconds", 1.2))

        if video_format == "long_form":
            # Cinematic, smooth vocal/transition ducking (Focuses on clarity and natural flow)
            threshold = -25.0
            ratio = "4:1"
            attack = 10.0  # Smooth ease-in (No harsh pumping)
            ducking = -8.0 if gain > -6.0 else -5.0
            # Slower, natural release
            release = min(600.0, max(200.0, (sweep_duration * 1000.0) * 0.6))
        else:
            # Short-form, aggressive Phonk pumping (EDM/Drift style sidechain)
            threshold = -35.0
            ratio = "12:1"
            attack = 1.5   # Instant snap ducking
            ducking = -15.0 if gain > -2.0 else -10.0
            # Fast, bouncy release
            release = min(200.0, max(50.0, (sweep_duration * 1000.0) * 0.8))

        return {
            "threshold_db": threshold,
            "ratio": ratio,
            "attack_time_ms": round(attack, 1),
            "release_time_ms": round(release, 1),
            "ducking_depth_db": round(ducking, 1),
            "routing_target": "background_music_and_sfx"
        }

    def execute_compression_routing(self):
        state = self._load_matrix_state()
        
        # 1. Atomic Handshake Protocol
        orchestrator = state.get("orchestrator_matrix", {})
        if orchestrator.get("next_agent") != self.agent_name:
            self.log(f"Execution suspended. Orchestrator expected '{orchestrator.get('next_agent')}'.", "WARNING")
            sys.exit(0)

        # 2. Extract Universal Configuration
        global_config = state.get("global_config", {})
        video_format = global_config.get("video_format", "short_form").lower()

        audio_module = state.get("module_b_audio", {})
        beat_map_data = audio_module.get("phonk_beat_map", {})
        events = beat_map_data.get("beat_sync_events", [])
        
        if not events:
            self.log("Beat events are missing. Ensure Ai_Agent_14 and Ai_Agent_15 ran successfully.", "FATAL")
            sys.exit(1)

        self.log(f"Calculating {video_format.upper()} procedural sidechain physics for master audio mix...", "STATUS")
        
        processed_triggers = 0

        # Idempotency Scrubbing & Applying Math
        for event in events:
            # Scrub previous calculations
            event.pop("sidechain_ducking_trigger", None)
            
            sub_profile = event.get("sub_bass_dsp_blueprint")
            if sub_profile:
                ducking_params = self.calculate_ducking_physics(sub_profile, video_format)
                event["sidechain_ducking_trigger"] = ducking_params
                processed_triggers += 1

        # State Update
        state["module_b_audio"]["phonk_beat_map"]["beat_sync_events"] = events
        state["module_b_audio"]["sidechain_compression_applied"] = True
        
        # 3. OmniMatrix Pipeline Handshake
        state["orchestrator_matrix"]["last_active_agent"] = self.agent_name
        # Heading towards AI Agent 17 (likely Sound FX / BGM mixing AI)
        state["orchestrator_matrix"]["next_agent"] = "Ai_Agent_17"
        
        self._save_matrix_state(state)
        self.log(f"Success! {processed_triggers} {video_format} sidechain routing triggers mathematically generated.")
        self.log("Module B Audio Mix is fully staged! Handoff to Ai_Agent_17.")

if __name__ == "__main__":
    compressor = Agent16AutomatedSidechainCompressor()
    compressor.execute_compression_routing()
